DATABASE_URL="file:./dev.db"
# Optional direct/unpooled Postgres URL for Prisma migrations and backups.
DATABASE_URL_UNPOOLED=""
POSTGRES_BACKUP_URL=""
APP_URL="http://localhost:3020"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@poke.local"
# Prefer ADMIN_PASSWORD_HASH in shared environments. ADMIN_PASSWORD is convenient for local-only setup.
ADMIN_PASSWORD="radar-admin"
ADMIN_PASSWORD_HASH=""
ADMIN_INVITE_SECRET="replace-with-private-invite-secret"
AUTH_SMOKE_URL=""
AUTH_SMOKE_EMAIL=""
AUTH_SMOKE_PASSWORD=""
MONITOR_JOB_SECRET="replace-with-private-monitor-secret"
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Keep this equal to MONITOR_JOB_SECRET.
CRON_SECRET="replace-with-private-monitor-secret"
# Product monitor cron is paused by default while legacy Products/Stores/Cards UI is hidden.
PRODUCT_MONITOR_CRON_ENABLED="false"
# Target watch products still use a safe batched cron path by default.
TARGET_MONITOR_CRON_ENABLED="true"
TARGET_MONITOR_BATCH_SIZE="18"
TARGET_MONITOR_CADENCE_MINUTES="15"
MONITOR_REQUEST_DELAY_MS="1500"
# Automatic Target discovery scans safe public Target search pages, suppresses
# marketplace/over-MSRP finds, and auto-approves strong retail/MSRP TCG products.
TARGET_DISCOVERY_AUTO_ENABLED="true"
TARGET_DISCOVERY_AUTO_APPROVAL_ENABLED="true"
TARGET_DISCOVERY_RETAIL_ONLY_ENABLED="true"
TARGET_DISCOVERY_CADENCE_MINUTES="360"
TARGET_DISCOVERY_AUTO_SOURCE_LIMIT="4"
TARGET_DISCOVERY_AUTO_APPROVE_LIMIT="12"
# Automatic Best Buy discovery is conservative. BESTBUY_API_KEY enables the
# official Products API path; otherwise the app falls back to public pages only.
BESTBUY_DISCOVERY_ENABLED="true"
BESTBUY_DISCOVERY_AUTO_APPROVAL_ENABLED="true"
BESTBUY_DISCOVERY_CADENCE_MINUTES="720"
BESTBUY_DISCOVERY_AUTO_SOURCE_LIMIT="3"
BESTBUY_DISCOVERY_AUTO_APPROVE_LIMIT="8"
BESTBUY_API_KEY=""

# Optional Phase 2+ notification providers.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EMAIL_PROVIDER=""
EMAIL_FROM=""
EMAIL_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional Phase 6 browser push. Generate with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@poke.local"

# Optional Phase 18 eBay completed/sold comp refresh.
# If these are blank, the app shows Manual comp mode and never invents comp prices.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_ENVIRONMENT="production"
EBAY_MARKETPLACE_ID="EBAY_US"

# Optional inventory market auto-pricing providers.
# Primary provider: TCGCSV server-side cache. TCGCSV estimates are not sold comps.
TCGCSV_ENABLED="false"
TCGCSV_BASE_URL="https://tcgcsv.com/tcgplayer"
TCGCSV_SYNC_FREQUENCY="daily"
# Optional fallbacks only.
PRICECHARTING_API_TOKEN=""
TCGPLAYER_PUBLIC_KEY=""
TCGPLAYER_PRIVATE_KEY=""
TCGPLAYER_ACCESS_TOKEN=""

# Optional UPC lookup/search providers for inventory barcode scanning.
# If these are blank, the server still tries the public UPCItemDB trial API
# after local inventory and watched-product matching. Keys are server-side only.
UPC_LOOKUP_API_URL=""
UPC_LOOKUP_API_KEY=""
# Broad UPC search fallback. Built-in providers: serpapi, custom.
# SerpApi Google Shopping example:
# PRODUCT_SEARCH_PROVIDER="serpapi"
# PRODUCT_SEARCH_API_URL="https://serpapi.com/search.json"
PRODUCT_SEARCH_PROVIDER=""
PRODUCT_SEARCH_API_URL=""
PRODUCT_SEARCH_API_KEY=""

# Optional public storefront + Stripe Checkout.
# The private radar stays admin-only; /shop and /cart expose only published listings.
STRIPE_CHECKOUT_ENABLED="false"
STORE_BASE_URL="http://localhost:3020"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Test-mode only. Requires STRIPE_SECRET_KEY to start with sk_test_.
STRIPE_TERMINAL_TEST_MODE_ENABLED="false"
# Placeholder for a future shipping-label integration. Not used by Phase 1 storefront.
SHIPPO_API_KEY=""

# Optional release calendar auto-sync.
# POKEMON_TCG_API_KEY raises limits for https://api.pokemontcg.io/v2/sets.
# POKEMON_RELEASE_SOURCE_URLS can point to extra direct source pages such as official
# Pokemon News articles, Pokemon Center product pages, or additional ICv2 calendar pages.
# The app already includes the default ICv2 2026 Pokemon TCG product calendar.
# POKEMON_RELEASE_FEED_URLS can point to public RSS/JSON feeds for product-drop news.
POKEMON_TCG_API_KEY=""
POKEMON_RELEASE_SOURCE_URLS=""
POKEMON_RELEASE_FEED_URLS=""
