{
  "name": "poke-restock-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:info": "tsx scripts/write-build-info.ts",
    "prebuild": "npm run build:info",
    "precheck": "npm run build:info",
    "prelint": "npm run build:info",
    "pretest": "npm run build:info",
    "prevercel-build": "npm run build:info",
    "dev": "npm run db:push && npm run db:seed && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:guardrails": "tsx --test tests/regression-guardrails.test.ts",
    "auth:smoke": "tsx scripts/auth-smoke.ts",
    "alert:smoke": "tsx scripts/alert-smoke.ts",
    "health:prod": "node scripts/check-production-health.mjs",
    "admin:reset": "tsx scripts/admin-reset.ts",
    "smoke:prod": "tsx scripts/final-production-smoke.ts",
    "qa:viewport": "tsx scripts/viewport-qa.ts",
    "backup:json": "tsx scripts/backup-data.ts",
    "restore:json": "tsx scripts/restore-data.ts",
    "backup:postgres": "tsx scripts/backup-postgres.ts",
    "restore:postgres": "tsx scripts/restore-postgres.ts",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "vapid:generate": "tsx scripts/generate-vapid.ts",
    "db:push": "prisma generate && tsx prisma/init-sqlite.ts",
    "db:seed": "prisma db seed",
    "prisma:postgres": "tsx scripts/prepare-postgres-schema.ts",
    "prisma:baseline:generate": "npm run prisma:postgres && tsx scripts/generate-prisma-postgres-baseline.ts",
    "prisma:baseline:verify": "npm run prisma:postgres && tsx scripts/verify-prisma-postgres-baseline.ts",
    "db:push:prod": "npm run prisma:postgres && prisma db push --schema .prisma-postgres/schema.prisma",
    "db:migrate:prod": "npm run prisma:postgres && tsx scripts/migrate-postgres-production.ts",
    "db:seed:prod": "npm run prisma:postgres && prisma db seed --schema .prisma-postgres/schema.prisma",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.4.0",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "bcryptjs": "3.0.2",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.15.18",
    "@types/nodemailer": "^6.4.19",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "playwright-core": "^1.57.0",
    "prisma": "6.19.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
