generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String
  role                     String                    @default("FRIEND")
  passwordHash             String
  canAddSightings          Boolean                   @default(true)
  canAddComps              Boolean                   @default(false)
  canRunChecks             Boolean                   @default(false)
  canReceivePushAlerts     Boolean                   @default(true)
  preferredZone            String                    @default("MIAMI")
  customZoneName           String?
  hideDistantStores        Boolean                   @default(false)
  currentLatitude          Float?
  currentLongitude         Float?
  locationUpdatedAt        DateTime?
  disabledAt               DateTime?
  sessionVersion           Int                       @default(0)
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sightings                StoreSighting[]
  alerts                   Alert[]
  notificationSettings     NotificationSettings?
  investmentSettings       InvestmentSettings?
  browserPushSubscriptions BrowserPushSubscription[]
  investmentReports        InvestmentReport[]
  passwordResetTokens      PasswordResetToken[]
  createdInvites           FriendInvite[]            @relation("InviteCreatedBy")
  acceptedInvites          FriendInvite[]            @relation("InviteAcceptedBy")
  auditLogs                AuditLog[]
  inventoryItems           InventoryItem[]
  inventoryAdjustments     InventoryAdjustment[]
  inventorySales           InventorySale[]
  barcodeScans             BarcodeScan[]
  dailyRecaps              DailyRecap[]
  savedFilterPresets       SavedFilterPreset[]
  storePreferences         UserStorePreference[]
  storefrontSettings       StorefrontSettings?
  storefrontOrders         StorefrontOrder[]
  storefrontCustomers      StorefrontCustomer[]
  customerAccounts         CustomerAccount[]
  shippingProfiles         ShippingProfile[]
  shippingQuotes           ShippingQuote[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model FriendInvite {
  id                   String    @id @default(cuid())
  email                String
  name                 String?
  tokenHash            String    @unique
  role                 String    @default("FRIEND")
  canAddSightings      Boolean   @default(true)
  canAddComps          Boolean   @default(false)
  canRunChecks         Boolean   @default(false)
  canReceivePushAlerts Boolean   @default(true)
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  createdById          String?
  acceptedById         String?
  createdBy            User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy           User?     @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
  @@index([createdById])
  @@index([acceptedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Retailer {
  id                  String                      @id @default(cuid())
  name                String                      @unique
  website             String?
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  products            Product[]
  stores              Store[]
  discoverySources    ProductDiscoverySource[]
  discoveryCandidates ProductDiscoveryCandidate[]
}

model Product {
  id                        String                 @id @default(cuid())
  retailerId                String
  releaseId                 String?
  name                      String
  url                       String
  setName                   String?
  productType               String?
  imageUrl                  String?
  expectedTitleKeywords     String?
  sku                       String?
  upc                       String?
  dpci                      String?
  retailerProductId         String?
  verificationStatus        String                 @default("UNVERIFIED")
  verifiedAt                DateTime?
  verifiedFinalUrl          String?
  verificationNotes         String?
  retailPrice               Float?
  liveTitle                 String?
  livePrice                 Float?
  livePriceSource           String?
  livePriceVerifiedAt       DateTime?
  liveStockStatus           String?
  liveStockVerifiedAt       DateTime?
  liveImageUrl              String?
  liveConfidenceScore       Int?
  liveBlockedType           String?
  sellerName                String?
  sellerType                String                 @default("unknown")
  fulfillmentType           String                 @default("unknown")
  sellerVerified            Boolean                @default(false)
  priceStatus               String                 @default("unknown")
  alertEligibility          String                 @default("needs_review")
  expectedRetailPrice       Float?
  maxAlertPrice             Float?
  allowOverMsrp             Boolean                @default(false)
  targetRetailMin           Float?
  targetRetailMax           Float?
  targetRetailReason        String?
  isDemoData                Boolean                @default(false)
  stockStatus               String                 @default("UNAVAILABLE")
  alertStatus               Boolean                @default(false)
  priority                  String                 @default("MEDIUM")
  rating                    String                 @default("WATCH")
  notes                     String?
  lastCheckedAt             DateTime?
  lastSuccessfulCheckedAt   DateTime?
  monitorEnabled            Boolean                @default(true)
  checkFrequencyMinutes     Int                    @default(60)
  nextCheckAt               DateTime?
  lastMonitorResult         String?
  lastMonitorError          String?
  lastPageHash              String?
  lastAlertSentAt           DateTime?
  requiredWords             String?
  ignoreWords               String?
  pendingAlertStatus        String?
  pendingAlertPrice         Float?
  pendingAlertPageHash      String?
  pendingAlertCount         Int                    @default(0)
  pendingAlertReason        String?
  pendingAlertConfidence    Int?
  pendingAlertDetectedWords String?
  pendingAlertAt            DateTime?
  sealedResaleNotes         String?
  scarcityNotes             String?
  manualPriorityOverride    String?
  archivedAt                DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  retailer                  Retailer               @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  release                   Release?               @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  alerts                    Alert[]
  history                   RestockHistory[]
  monitorLogs               MonitorLog[]
  priorityScores            ProductPriorityScore[]
  inventoryItems            InventoryItem[]
  barcodeScans              BarcodeScan[]

  @@index([retailerId])
  @@index([releaseId])
  @@index([setName])
  @@index([productType])
  @@index([upc])
  @@index([retailerProductId])
  @@index([verificationStatus])
  @@index([stockStatus])
  @@index([liveStockStatus])
  @@index([sellerType])
  @@index([priceStatus])
  @@index([alertEligibility])
  @@index([isDemoData])
  @@index([archivedAt])
  @@index([lastCheckedAt])
  @@index([lastSuccessfulCheckedAt])
  @@index([nextCheckAt])
  @@index([monitorEnabled])
  @@index([retailerId, monitorEnabled, liveStockStatus])
}

model Store {
  id                       String                @id @default(cuid())
  retailerId               String
  storeName                String
  address                  String
  city                     String
  state                    String
  zone                     String                @default("MIAMI")
  latitude                 Float?
  longitude                Float?
  notes                    String?
  typicalRestockDays       String
  typicalRestockTimeWindow String
  vendorNotes              String?
  confidenceScore          Int                   @default(50)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  retailer                 Retailer              @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sightings                StoreSighting[]
  userPreferences          UserStorePreference[]

  @@index([retailerId])
  @@index([zone])
}

model UserStorePreference {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  favorite  Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([favorite])
  @@index([hidden])
}

model StoreSighting {
  id               String   @id @default(cuid())
  storeId          String
  userId           String
  productSeen      String
  resultType       String   @default("stock_seen")
  seenAt           DateTime
  quantityEstimate String
  shelfPhotoUrl    String?
  notes            String?
  createdAt        DateTime @default(now())
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@index([resultType])
  @@index([seenAt])
}

model Release {
  id                            String    @id @default(cuid())
  setName                       String
  releaseName                   String?
  productName                   String?
  productType                   String?
  releaseType                   String    @default("expansion")
  officialReleaseDate           DateTime?
  preorderDate                  DateTime?
  preorderWindowText            String?
  region                        String    @default("US")
  retailer                      String?
  productTypes                  String
  pokemonCenterExclusiveVersion Boolean   @default(false)
  productImage                  String?
  productUrl                    String?
  chaseCards                    String?
  demandRating                  String    @default("MEDIUM")
  estimatedDemand               String    @default("MEDIUM")
  priority                      String    @default("MEDIUM")
  sealedProductPriority         String    @default("MEDIUM")
  notes                         String?
  productLinks                  String?
  supportingSources             String?
  sourceUrl                     String?
  sourceName                    String?
  sourceType                    String    @default("manual")
  confidence                    String    @default("MEDIUM")
  status                        String    @default("upcoming")
  lastSyncedAt                  DateTime?
  createdByManualEntry          Boolean   @default(true)
  needsReview                   Boolean   @default(false)
  reviewReason                  String?
  previousReleaseDate           DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  products                      Product[]
  cards                         Card[]

  @@index([officialReleaseDate])
  @@index([preorderDate])
  @@index([status])
  @@index([needsReview])
}

model ReleaseSyncSource {
  id                    String    @id @default(cuid())
  sourceName            String
  sourceType            String    @default("custom_public_feed")
  sourceUrl             String    @unique
  adapter               String
  enabled               Boolean   @default(true)
  priority              Int       @default(50)
  confidenceDefault     String    @default("MEDIUM")
  lastCheckedAt         DateTime?
  lastSuccessfulParseAt DateTime?
  lastHttpStatus        Int?
  lastStatus            String?
  lastError             String?
  parsedCount           Int       @default(0)
  createdCount          Int       @default(0)
  updatedCount          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([sourceType])
  @@index([adapter])
  @@index([enabled])
  @@index([lastStatus])
}

model ReleaseSyncLog {
  id             String   @id @default(cuid())
  checkedAt      DateTime @default(now())
  sourceName     String
  sourceUrl      String?
  sourceType     String   @default("custom_public_feed")
  adapter        String
  status         String   @default("active")
  httpStatus     Int?
  parsedCount    Int      @default(0)
  createdCount   Int      @default(0)
  updatedCount   Int      @default(0)
  duplicateCount Int      @default(0)
  conflictCount  Int      @default(0)
  warningCount   Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())

  @@index([checkedAt])
  @@index([adapter])
  @@index([status])
}

model Alert {
  id              String    @id @default(cuid())
  title           String
  reason          String
  priority        String    @default("MEDIUM")
  timestamp       DateTime  @default(now())
  entityType      String
  entityId        String?
  actionUrl       String?
  read            Boolean   @default(false)
  score           Int       @default(50)
  dedupeKey       String?
  explanation     String?
  falsePositiveAt DateTime?
  suppressedAt    DateTime?
  cooldownUntil   DateTime?
  productId       String?
  userId          String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([read])
  @@index([priority])
  @@index([userId])
  @@index([entityType])
  @@index([entityType, productId])
  @@index([timestamp])
  @@index([score])
  @@index([dedupeKey])
  @@index([falsePositiveAt])
}

model NotificationDeliveryLog {
  id         String   @id @default(cuid())
  alertId    String?
  userId     String?
  productId  String?
  channel    String
  status     String
  reason     String?
  detail     String?
  dedupeKey  String?
  priority   String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([alertId])
  @@index([userId])
  @@index([productId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model RestockHistory {
  id             String   @id @default(cuid())
  productId      String
  status         String
  price          Float?
  snapshotReason String
  checkedAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([checkedAt])
}

model MonitorLog {
  id                  String    @id @default(cuid())
  productId           String?
  runType             String
  status              String
  previousStatus      String?
  detectedStatus      String?
  previousPrice       Float?
  detectedPrice       Float?
  changeSummary       String?
  httpStatus          Int?
  finalUrl            String?
  responseTimeMs      Int?
  detectedWords       String?
  confidenceScore     Int?
  reason              String?
  blockedType         String?
  pageHash            String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  durationMs          Int?
  error               String?
  alertSent           Boolean   @default(false)
  notificationSummary String?
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([startedAt])
  @@index([status])
}

model ProductDiscoverySource {
  id                      String                      @id @default(cuid())
  retailerId              String
  name                    String
  url                     String
  notes                   String?
  enabled                 Boolean                     @default(true)
  checkFrequencyMinutes   Int                         @default(360)
  nextCheckAt             DateTime?
  lastCheckedAt           DateTime?
  lastSuccessfulCheckedAt DateTime?
  lastResult              String?
  lastError               String?
  lastFoundCount          Int                         @default(0)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  retailer                Retailer                    @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  candidates              ProductDiscoveryCandidate[]

  @@index([retailerId])
  @@index([enabled])
  @@index([nextCheckAt])
}

model ProductDiscoveryCandidate {
  id                  String                 @id @default(cuid())
  sourceId            String
  retailerId          String
  url                 String
  finalUrl            String?
  productName         String
  productType         String?
  retailerProductId   String?
  sku                 String?
  upc                 String?
  dpci                String?
  brand               String?
  category            String?
  description         String?
  itemDetails         String?
  imageUrl            String?
  livePrice           Float?
  stockStatus         String?
  sellerName          String?
  sellerType          String                 @default("unknown")
  fulfillmentType     String                 @default("unknown")
  sellerVerified      Boolean                @default(false)
  priceStatus         String                 @default("unknown")
  alertEligibility    String                 @default("needs_review")
  expectedRetailPrice Float?
  maxAlertPrice       Float?
  targetRetailMin     Float?
  targetRetailMax     Float?
  targetRetailReason  String?
  enrichmentStatus    String                 @default("NEEDS_REVIEW")
  enrichmentReason    String?
  enrichedAt          DateTime?
  confidenceScore     Int                    @default(50)
  reason              String?
  status              String                 @default("PENDING")
  approvedProductId   String?
  reviewedAt          DateTime?
  ignoredAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  source              ProductDiscoverySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  retailer            Retailer               @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([retailerId])
  @@index([status])
  @@index([retailerProductId])
  @@index([upc])
  @@index([dpci])
  @@index([sellerType])
  @@index([priceStatus])
  @@index([alertEligibility])
  @@index([enrichmentStatus])
  @@index([createdAt])
}

model Card {
  id                            String              @id @default(cuid())
  releaseId                     String?
  cardName                      String
  setName                       String
  cardNumber                    String
  rarity                        String
  rawAveragePrice               Float
  psa9AverageSalePrice          Float
  psa10AverageSalePrice         Float
  bgs95AverageSalePrice         Float               @default(0)
  bgs10AverageSalePrice         Float               @default(0)
  bgsBlackLabelAverageSalePrice Float               @default(0)
  estimatedEbayFee              Float               @default(0.1325)
  estimatedGradingCost          Float
  estimatedShippingCost         Float               @default(5)
  minimumProfitTarget           Float               @default(20)
  psa9EstimatedProfit           Float
  psa10EstimatedProfit          Float
  bgs10EstimatedProfit          Float               @default(0)
  blackLabelEstimatedProfit     Float               @default(0)
  maxRawBuyPricePsa9            Float
  maxRawBuyPrice                Float               @default(0)
  top10Score                    Int                 @default(0)
  compConfidenceScore           Int                 @default(0)
  rating                        String              @default("WATCH")
  dataSource                    String
  lastRefreshed                 DateTime
  notes                         String?
  characterName                 String?
  era                           String              @default("MODERN")
  lowPop                        Boolean             @default(false)
  newRelease                    Boolean             @default(false)
  lowNumberedSerialized         Boolean             @default(false)
  strongCharacterDemand         Boolean             @default(false)
  ebayIncludeWords              String?
  ebayExcludeWords              String?
  ebayExactSetName              Boolean             @default(true)
  ebayCardNumberRequired        Boolean             @default(true)
  ebayRawKeywords               String?
  ebayPsa9Keywords              String?
  ebayPsa10Keywords             String?
  ebayAllowNonEnglish           Boolean             @default(false)
  lastCompAt                    DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  release                       Release?            @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  snapshots                     CardPriceSnapshot[]
  compSales                     CardCompSale[]
  inventoryItems                InventoryItem[]

  @@index([releaseId])
  @@index([setName])
}

model CardPriceSnapshot {
  id                            String   @id @default(cuid())
  cardId                        String
  rawAveragePrice               Float
  psa9AverageSalePrice          Float
  psa10AverageSalePrice         Float
  bgs95AverageSalePrice         Float    @default(0)
  bgs10AverageSalePrice         Float    @default(0)
  bgsBlackLabelAverageSalePrice Float    @default(0)
  psa9EstimatedProfit           Float
  psa10EstimatedProfit          Float
  bgs10EstimatedProfit          Float    @default(0)
  blackLabelEstimatedProfit     Float    @default(0)
  maxRawBuyPrice                Float    @default(0)
  top10Score                    Int      @default(0)
  rating                        String
  snapshotAt                    DateTime @default(now())
  card                          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([snapshotAt])
}

model CardCompSale {
  id             String    @id @default(cuid())
  cardId         String
  source         String
  salePrice      Float
  grade          String
  gradeType      String    @default("RAW")
  soldAt         DateTime
  url            String?
  sourceUrl      String?
  saleTitle      String?
  matchScore     Int       @default(0)
  notes          String?
  conditionNotes String?
  sourceQuality  String    @default("EBAY_SOLD")
  reviewStatus   String    @default("ACCEPTED")
  rejectedAt     DateTime?
  createdAt      DateTime  @default(now())
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([gradeType])
  @@index([sourceQuality])
  @@index([reviewStatus])
  @@index([soldAt])
  @@index([matchScore])
}

model InvestmentReport {
  id                 String   @id @default(cuid())
  userId             String?
  title              String
  generatedAt        DateTime @default(now())
  periodStart        DateTime
  periodEnd          DateTime
  top10RawToGrade    String
  safestPsa9Flips    String
  highestPsa10Upside String
  beckettCandidates  String
  avoidOverpriced    String
  bestBuy            String?
  riskiestBuy        String?
  bestUnder25Raw     String?
  bestPremiumCard    String?
  notes              String?
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([generatedAt])
  @@index([userId])
}

model InvestmentSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  gradingCost         Float    @default(20)
  ebaySellingFee      Float    @default(0.1325)
  shippingCost        Float    @default(5)
  minimumProfitTarget Float    @default(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id                            String                  @id @default(cuid())
  userId                        String?
  itemType                      String
  itemName                      String
  category                      String                  @default("sealed_packs")
  setName                       String?
  productId                     String?
  cardId                        String?
  cost                          Float
  quantity                      Int                     @default(1)
  totalCost                     Float?
  purchaseExtraCost             Float?
  source                        String
  retailer                      String?
  brand                         String?
  description                   String?
  manufacturer                  String?
  model                         String?
  msrp                          Float?
  purchasedAt                   DateTime
  receiptNumber                 String?
  receiptImageUrl               String?
  orderNumber                   String?
  transactionId                 String?
  sourceStore                   String?
  paymentMethod                 String?
  exactProductUrl               String?
  upc                           String?
  sku                           String?
  taxCategory                   String?
  stripeTaxCode                 String?
  taxableOverride               Boolean?
  dpci                          String?
  asin                          String?
  imageUrl                      String?
  condition                     String?
  itemStatus                    String                  @default("sealed")
  targetSellPrice               Float?
  minimumAcceptablePrice        Float?
  listingPlatform               String?
  listingStatus                 String                  @default("not_listed")
  soldPrice                     Float?
  soldAt                        DateTime?
  buyerPlatform                 String?
  currentMarketEstimate         Float?
  marketAverageSalePrice        Float?
  marketCompCount               Int                     @default(0)
  marketLastRefreshedAt         DateTime?
  marketConfidence              String                  @default("LOW")
  marketProvider                String?
  marketProviderProductId       String?
  marketProviderProductName     String?
  marketProviderMatchStatus     String                  @default("UNMATCHED")
  marketProviderConfidenceScore Int                     @default(0)
  marketProviderMatchReason     String?
  marketProviderMatchedAt       DateTime?
  marketProviderLastPricedAt    DateTime?
  estimatedEbayFee              Float?
  estimatedShippingCost         Float?
  estimatedNetProfit            Float?
  roiPercent                    Float?
  recommendedAction             String                  @default("HOLD")
  recommendationReason          String?
  netProfitAfterFees            Float?
  publishToStore                Boolean                 @default(false)
  publicSlug                    String?                 @unique
  publicTitle                   String?
  publicDescription             String?
  publicPrice                   Float?
  compareAtPrice                Float?
  publicImages                  String?
  availableForSale              Int?
  maxQuantityPerOrder           Int                     @default(4)
  purchaseLimitEnabled          Boolean                 @default(false)
  shippingProfile               String                  @default("standard")
  packageWeightOz               Float?
  packageLengthIn               Float?
  packageWidthIn                Float?
  packageHeightIn               Float?
  shippingMetadataSource        String?
  freeShippingEligible          Boolean                 @default(false)
  requiresBox                   Boolean                 @default(false)
  insuranceRecommended          Boolean                 @default(false)
  storeStatus                   String                  @default("draft")
  localPickupAvailable          Boolean                 @default(true)
  shippingAvailable             Boolean                 @default(true)
  storefrontCategory            String?
  storefrontTags                String?
  publishedAt                   DateTime?
  authenticityProofStatus       String?
  authenticityReceiptStatus     String?
  authenticityPhotoStatus       String?
  authenticityUpcVerified       Boolean?
  authenticityNotes             String?
  expectedPlan                  String?
  notes                         String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  user                          User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product                       Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  card                          Card?                   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  marketComps                   InventoryMarketComp[]
