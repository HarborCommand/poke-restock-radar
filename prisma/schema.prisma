  createdAt         DateTime          @default(now())
  customerAccount   CustomerAccount   @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  order             StorefrontOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerAccountId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([availableAt])
  @@index([source])
  @@index([reversalOfEntryId])
  @@index([createdAt])
}

model RewardAuditFinding {
  id                    String   @id @default(cuid())
  findingFingerprint    String   @unique
  findingCode           String
  severity              String
  customerAccountId     String?
  sourceType            String?
  sourceReferenceHash   String?
  rewardLedgerEntryId   String?
  status                String   @default("open")
  metadataJson          String?
  firstDetectedAt       DateTime @default(now())
  lastDetectedAt        DateTime @updatedAt
  occurrenceCount       Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([findingCode])
  @@index([severity])
  @@index([customerAccountId])
  @@index([sourceType])
  @@index([status])
  @@index([firstDetectedAt])
  @@index([lastDetectedAt])
}

model RewardBalance {
  customerAccountId    String          @id
  availablePoints      Int             @default(0)
  lifetimeEarnedPoints Int             @default(0)
  pendingPoints        Int             @default(0)
  updatedAt            DateTime        @updatedAt
  customerAccount      CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
}

model Fulfillment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  status         String          @default("unfulfilled")
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          StorefrontOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DailyRecap {
  id            String   @id @default(cuid())
  userId        String?
  recapDate     DateTime
  summary       String
  productChecks Int      @default(0)
  storeVisits   Int      @default(0)
  purchases     Int      @default(0)
  alertsCreated Int      @default(0)
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recapDate])
  @@index([createdAt])
}

model SavedFilterPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  section   String
  filters   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([section])
}

model ProductPriorityScore {
  id                  String   @id @default(cuid())
  productId           String
  releaseId           String?
  buyWatchSkip        String
  score               Int
  retailPriceScore    Int      @default(0)
  resaleDemandScore   Int      @default(0)
  setPopularityScore  Int      @default(0)
  scarcityScore       Int      @default(0)
  chaseCardScore      Int      @default(0)
  sealedValueScore    Int      @default(0)
  cardInvestmentScore Int      @default(0)
  profitablePsa9Count Int      @default(0)
  psa10Upside         Float    @default(0)
  manualOverride      String?
  reason              String?
  userNotes           String?
  computedAt          DateTime @default(now())
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([releaseId])
}

model NotificationSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  inApp                Boolean  @default(true)
  sms                  Boolean  @default(false)
  email                Boolean  @default(false)
  browserPush          Boolean  @default(false)
  phone                String?
  emailTo              String?
  quietHoursStart      String?
  quietHoursEnd        String?
  minimumPriority      String   @default("LOW")
  alertDigestMode      Boolean  @default(false)
  urgentOnlyMode       Boolean  @default(false)
  highPriorityOverride Boolean  @default(true)
  watchedRetailers     String?
  watchedProducts      String?
  alertCooldownMinutes Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrowserPushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([disabledAt])
}
