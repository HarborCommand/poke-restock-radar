generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String
  role                     String                    @default("FRIEND")
  passwordHash             String
  canAddSightings          Boolean                   @default(true)
  canAddComps              Boolean                   @default(false)
  canRunChecks             Boolean                   @default(false)
  canReceivePushAlerts     Boolean                   @default(true)
  preferredZone            String                    @default("MIAMI")
  customZoneName           String?
  hideDistantStores        Boolean                   @default(false)
  disabledAt               DateTime?
  sessionVersion           Int                       @default(0)
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sightings                StoreSighting[]
  alerts                   Alert[]
  notificationSettings     NotificationSettings?
  investmentSettings       InvestmentSettings?
  browserPushSubscriptions BrowserPushSubscription[]
  investmentReports        InvestmentReport[]
  passwordResetTokens      PasswordResetToken[]
  createdInvites           FriendInvite[]            @relation("InviteCreatedBy")
  acceptedInvites          FriendInvite[]            @relation("InviteAcceptedBy")
  auditLogs                AuditLog[]
  inventoryItems           InventoryItem[]
  dailyRecaps              DailyRecap[]
  savedFilterPresets       SavedFilterPreset[]
  storePreferences         UserStorePreference[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model FriendInvite {
  id                   String    @id @default(cuid())
  email                String
  name                 String?
  tokenHash            String    @unique
  role                 String    @default("FRIEND")
  canAddSightings      Boolean   @default(true)
  canAddComps          Boolean   @default(false)
  canRunChecks         Boolean   @default(false)
  canReceivePushAlerts Boolean   @default(true)
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  createdById          String?
  acceptedById         String?
  createdBy            User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy           User?     @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
  @@index([createdById])
  @@index([acceptedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Retailer {
  id        String    @id @default(cuid())
  name      String    @unique
  website   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  stores    Store[]
}

model Product {
  id                        String                 @id @default(cuid())
  retailerId                String
  releaseId                 String?
  name                      String
  url                       String
  setName                   String?
  productType               String?
  sku                       String?
  upc                       String?
  dpci                      String?
  retailerProductId         String?
  verificationStatus        String                 @default("UNVERIFIED")
  verifiedAt                DateTime?
  verifiedFinalUrl          String?
  verificationNotes         String?
  retailPrice               Float?
  stockStatus               String                 @default("UNAVAILABLE")
  alertStatus               Boolean                @default(false)
  priority                  String                 @default("MEDIUM")
  rating                    String                 @default("WATCH")
  notes                     String?
  lastCheckedAt             DateTime?
  lastSuccessfulCheckedAt   DateTime?
  monitorEnabled            Boolean                @default(true)
  checkFrequencyMinutes     Int                    @default(60)
  nextCheckAt               DateTime?
  lastMonitorResult         String?
  lastMonitorError          String?
  lastPageHash              String?
  lastAlertSentAt           DateTime?
  requiredWords             String?
  ignoreWords               String?
  pendingAlertStatus        String?
  pendingAlertPrice         Float?
  pendingAlertPageHash      String?
  pendingAlertCount         Int                    @default(0)
  pendingAlertReason        String?
  pendingAlertConfidence    Int?
  pendingAlertDetectedWords String?
  pendingAlertAt            DateTime?
  sealedResaleNotes         String?
  scarcityNotes             String?
  manualPriorityOverride    String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  retailer                  Retailer               @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  release                   Release?               @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  alerts                    Alert[]
  history                   RestockHistory[]
  monitorLogs               MonitorLog[]
  priorityScores            ProductPriorityScore[]
  inventoryItems            InventoryItem[]

  @@index([retailerId])
  @@index([releaseId])
  @@index([setName])
  @@index([productType])
  @@index([upc])
  @@index([retailerProductId])
  @@index([verificationStatus])
  @@index([stockStatus])
  @@index([nextCheckAt])
  @@index([monitorEnabled])
}

model Store {
  id                       String                @id @default(cuid())
  retailerId               String
  storeName                String
  address                  String
  city                     String
  state                    String
  zone                     String                @default("MIAMI")
  latitude                 Float?
  longitude                Float?
  notes                    String?
  typicalRestockDays       String
  typicalRestockTimeWindow String
  vendorNotes              String?
  confidenceScore          Int                   @default(50)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  retailer                 Retailer              @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sightings                StoreSighting[]
  userPreferences          UserStorePreference[]

  @@index([retailerId])
  @@index([zone])
}

model UserStorePreference {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  favorite  Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([favorite])
  @@index([hidden])
}

model StoreSighting {
  id               String   @id @default(cuid())
  storeId          String
  userId           String
  productSeen      String
  resultType       String   @default("stock_seen")
  seenAt           DateTime
  quantityEstimate String
  shelfPhotoUrl    String?
  notes            String?
  createdAt        DateTime @default(now())
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@index([resultType])
  @@index([seenAt])
}

model Release {
  id                            String    @id @default(cuid())
  setName                       String
  productType                   String?
  officialReleaseDate           DateTime
  preorderDate                  DateTime?
  productTypes                  String
  pokemonCenterExclusiveVersion Boolean   @default(false)
  chaseCards                    String?
  demandRating                  String    @default("MEDIUM")
  estimatedDemand               String    @default("MEDIUM")
  priority                      String    @default("MEDIUM")
  sealedProductPriority         String    @default("MEDIUM")
  notes                         String?
  productLinks                  String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  products                      Product[]
  cards                         Card[]
}

model Alert {
  id              String    @id @default(cuid())
  title           String
  reason          String
  priority        String    @default("MEDIUM")
  timestamp       DateTime  @default(now())
  entityType      String
  entityId        String?
  actionUrl       String?
  read            Boolean   @default(false)
  score           Int       @default(50)
  dedupeKey       String?
  explanation     String?
  falsePositiveAt DateTime?
  suppressedAt    DateTime?
  cooldownUntil   DateTime?
  productId       String?
  userId          String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([read])
  @@index([priority])
  @@index([userId])
  @@index([score])
  @@index([dedupeKey])
  @@index([falsePositiveAt])
}

model RestockHistory {
  id             String   @id @default(cuid())
  productId      String
  status         String
  price          Float?
  snapshotReason String
  checkedAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([checkedAt])
}

model MonitorLog {
  id                  String    @id @default(cuid())
  productId           String?
  runType             String
  status              String
  previousStatus      String?
  detectedStatus      String?
  previousPrice       Float?
  detectedPrice       Float?
  changeSummary       String?
  httpStatus          Int?
  finalUrl            String?
  responseTimeMs      Int?
  detectedWords       String?
  confidenceScore     Int?
  reason              String?
  blockedType         String?
  pageHash            String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  durationMs          Int?
  error               String?
  alertSent           Boolean   @default(false)
  notificationSummary String?
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([startedAt])
  @@index([status])
}

model Card {
  id                            String              @id @default(cuid())
  releaseId                     String?
  cardName                      String
  setName                       String
  cardNumber                    String
  rarity                        String
  rawAveragePrice               Float
  psa9AverageSalePrice          Float
  psa10AverageSalePrice         Float
  bgs95AverageSalePrice         Float               @default(0)
  bgs10AverageSalePrice         Float               @default(0)
  bgsBlackLabelAverageSalePrice Float               @default(0)
  estimatedEbayFee              Float               @default(0.1325)
  estimatedGradingCost          Float
  estimatedShippingCost         Float               @default(5)
  minimumProfitTarget           Float               @default(20)
  psa9EstimatedProfit           Float
  psa10EstimatedProfit          Float
  bgs10EstimatedProfit          Float               @default(0)
  blackLabelEstimatedProfit     Float               @default(0)
  maxRawBuyPricePsa9            Float
  maxRawBuyPrice                Float               @default(0)
  top10Score                    Int                 @default(0)
  compConfidenceScore           Int                 @default(0)
  rating                        String              @default("WATCH")
  dataSource                    String
  lastRefreshed                 DateTime
  notes                         String?
  characterName                 String?
  era                           String              @default("MODERN")
  lowPop                        Boolean             @default(false)
  newRelease                    Boolean             @default(false)
  lowNumberedSerialized         Boolean             @default(false)
  strongCharacterDemand         Boolean             @default(false)
  lastCompAt                    DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  release                       Release?            @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  snapshots                     CardPriceSnapshot[]
  compSales                     CardCompSale[]
  inventoryItems                InventoryItem[]

  @@index([releaseId])
  @@index([setName])
}

model CardPriceSnapshot {
  id                            String   @id @default(cuid())
  cardId                        String
  rawAveragePrice               Float
  psa9AverageSalePrice          Float
  psa10AverageSalePrice         Float
  bgs95AverageSalePrice         Float    @default(0)
  bgs10AverageSalePrice         Float    @default(0)
  bgsBlackLabelAverageSalePrice Float    @default(0)
  psa9EstimatedProfit           Float
  psa10EstimatedProfit          Float
  bgs10EstimatedProfit          Float    @default(0)
  blackLabelEstimatedProfit     Float    @default(0)
  maxRawBuyPrice                Float    @default(0)
  top10Score                    Int      @default(0)
  rating                        String
  snapshotAt                    DateTime @default(now())
  card                          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([snapshotAt])
}

model CardCompSale {
  id             String   @id @default(cuid())
  cardId         String
  source         String
  salePrice      Float
  grade          String
  gradeType      String   @default("RAW")
  soldAt         DateTime
  url            String?
  sourceUrl      String?
  notes          String?
  conditionNotes String?
  sourceQuality  String   @default("EBAY_SOLD")
  createdAt      DateTime @default(now())
  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([gradeType])
  @@index([sourceQuality])
  @@index([soldAt])
}

model InvestmentReport {
  id                 String   @id @default(cuid())
  userId             String?
  title              String
  generatedAt        DateTime @default(now())
  periodStart        DateTime
  periodEnd          DateTime
  top10RawToGrade    String
  safestPsa9Flips    String
  highestPsa10Upside String
  beckettCandidates  String
  avoidOverpriced    String
  bestBuy            String?
  riskiestBuy        String?
  bestUnder25Raw     String?
  bestPremiumCard    String?
  notes              String?
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([generatedAt])
  @@index([userId])
}

model InvestmentSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  gradingCost         Float    @default(20)
  ebaySellingFee      Float    @default(0.1325)
  shippingCost        Float    @default(5)
  minimumProfitTarget Float    @default(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id           String   @id @default(cuid())
  userId       String?
  itemType     String
  itemName     String
  productId    String?
  cardId       String?
  cost         Float
  quantity     Int      @default(1)
  source       String
  purchasedAt  DateTime
  expectedPlan String?
  notes        String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  card         Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([cardId])
  @@index([purchasedAt])
}

model DailyRecap {
  id            String   @id @default(cuid())
  userId        String?
  recapDate     DateTime
  summary       String
  productChecks Int      @default(0)
  storeVisits   Int      @default(0)
  purchases     Int      @default(0)
  alertsCreated Int      @default(0)
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recapDate])
  @@index([createdAt])
}

model SavedFilterPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  section   String
  filters   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([section])
}

model ProductPriorityScore {
  id                  String   @id @default(cuid())
  productId           String
  releaseId           String?
  buyWatchSkip        String
  score               Int
  retailPriceScore    Int      @default(0)
  resaleDemandScore   Int      @default(0)
  setPopularityScore  Int      @default(0)
  scarcityScore       Int      @default(0)
  chaseCardScore      Int      @default(0)
  sealedValueScore    Int      @default(0)
  cardInvestmentScore Int      @default(0)
  profitablePsa9Count Int      @default(0)
  psa10Upside         Float    @default(0)
  manualOverride      String?
  reason              String?
  userNotes           String?
  computedAt          DateTime @default(now())
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([releaseId])
}

model NotificationSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  inApp                Boolean  @default(true)
  sms                  Boolean  @default(false)
  email                Boolean  @default(false)
  browserPush          Boolean  @default(false)
  phone                String?
  emailTo              String?
  quietHoursStart      String?
  quietHoursEnd        String?
  minimumPriority      String   @default("LOW")
  alertDigestMode      Boolean  @default(false)
  urgentOnlyMode       Boolean  @default(false)
  highPriorityOverride Boolean  @default(true)
  watchedRetailers     String?
  watchedProducts      String?
  alertCooldownMinutes Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrowserPushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([disabledAt])
}
